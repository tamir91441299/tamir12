{
  "entities": {
    "Score": {
      "title": "Score",
      "description": "Game scores and player submission records for Anime Guesser",
      "type": "object",
      "properties": {
        "playerName": {
          "type": "string",
          "description": "Name of the player"
        },
        "score": {
          "type": "number",
          "description": "Total score earned"
        },
        "gameMode": {
          "type": "string",
          "description": "Game mode played ('character' or 'title')"
        },
        "totalQuestions": {
          "type": "number",
          "description": "Total number of questions answered"
        },
        "correctCount": {
          "type": "number",
          "description": "Number of correct answers"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the score was saved"
        },
        "answers": {
          "type": "array",
          "description": "Summary of answers submitted during the game session"
        }
      },
      "required": ["playerName", "score", "gameMode", "createdAt"]
    },
    "Movie": {
      "title": "Movie",
      "description": "Movie and Anime records. Only admin Tamir (tamir91441299@gmail.com) is permitted to upload, create or modify video content.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Original title"
        },
        "titleMongolian": {
          "type": "string",
          "description": "Mongolian translated title"
        },
        "videoUrl": {
          "type": "string",
          "description": "Streaming video embed URL (admin only)"
        },
        "type": {
          "type": "string",
          "description": "Content type: anime, movie, or series"
        }
      },
      "required": ["title", "titleMongolian"]
    },
    "Episode": {
      "title": "Episode",
      "description": "Video episode details for anime/series. Strictly admin-only authoring.",
      "type": "object",
      "properties": {
        "episodeNumber": {
          "type": "number",
          "description": "Episode number"
        },
        "title": {
          "type": "string",
          "description": "Episode title"
        },
        "videoUrl": {
          "type": "string",
          "description": "Direct video stream or embed URL"
        },
        "duration": {
          "type": "string",
          "description": "Episode runtime duration"
        }
      },
      "required": ["episodeNumber", "videoUrl"]
    },
    "AnimeView": {
      "title": "AnimeView",
      "description": "User viewing records for anime to track view counts and viewer user profiles",
      "type": "object",
      "properties": {
        "movieId": {
          "type": "string",
          "description": "ID of the anime movie"
        },
        "userId": {
          "type": "string",
          "description": "ID of the user who watched"
        },
        "userName": {
          "type": "string",
          "description": "Display name of the watcher"
        },
        "userAvatar": {
          "type": "string",
          "description": "Avatar URL of the watcher"
        },
        "episodeNumber": {
          "type": "number",
          "description": "The episode number watched"
        },
        "watchedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user watched"
        }
      },
      "required": ["movieId", "userName", "watchedAt"]
    }
  },
  "firestore": {
    "/scores/{scoreId}": {
      "schema": "Score",
      "description": "Leaderboard game scores"
    },
    "/movies/{movieId}": {
      "schema": "Movie",
      "description": "Anime and movies collection. Only master admin can create, update, or upload video entries."
    },
    "/episodes/{epId}": {
      "schema": "Episode",
      "description": "Video episodes collection. Only master admin can create, update, or upload video episodes."
    },
    "/anime_views/{viewId}": {
      "schema": "AnimeView",
      "description": "Anime viewing records and watcher user list"
    }
  }
}
