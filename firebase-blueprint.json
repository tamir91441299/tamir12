{
  "entities": {
    "Score": {
      "title": "Score",
      "description": "Game scores and player submission records for Anime Guesser",
      "type": "object",
      "properties": {
        "playerName": {
          "type": "string",
          "description": "Name of the player"
        },
        "score": {
          "type": "number",
          "description": "Total score earned"
        },
        "gameMode": {
          "type": "string",
          "description": "Game mode played ('character' or 'title')"
        },
        "totalQuestions": {
          "type": "number",
          "description": "Total number of questions answered"
        },
        "correctCount": {
          "type": "number",
          "description": "Number of correct answers"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the score was saved"
        },
        "answers": {
          "type": "array",
          "description": "Summary of answers submitted during the game session"
        }
      },
      "required": ["playerName", "score", "gameMode", "createdAt"]
    },
    "Movie": {
      "title": "Movie",
      "description": "Movie and Anime records. Only admin Tamir (tamir91441299@gmail.com) is permitted to upload, create or modify video content.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Original title"
        },
        "titleMongolian": {
          "type": "string",
          "description": "Mongolian translated title"
        },
        "videoUrl": {
          "type": "string",
          "description": "Streaming video embed URL (admin only)"
        },
        "type": {
          "type": "string",
          "description": "Content type: anime, movie, or series"
        }
      },
      "required": ["title", "titleMongolian"]
    },
    "Episode": {
      "title": "Episode",
      "description": "Video episode details for anime/series. Strictly admin-only authoring.",
      "type": "object",
      "properties": {
        "episodeNumber": {
          "type": "number",
          "description": "Episode number"
        },
        "title": {
          "type": "string",
          "description": "Episode title"
        },
        "videoUrl": {
          "type": "string",
          "description": "Direct video stream or embed URL"
        },
        "duration": {
          "type": "string",
          "description": "Episode runtime duration"
        }
      },
      "required": ["episodeNumber", "videoUrl"]
    },
    "AnimeView": {
      "title": "AnimeView",
      "description": "User viewing records for anime to track view counts and viewer user profiles",
      "type": "object",
      "properties": {
        "movieId": {
          "type": "string",
          "description": "ID of the anime movie"
        },
        "userId": {
          "type": "string",
          "description": "ID of the user who watched"
        },
        "userName": {
          "type": "string",
          "description": "Display name of the watcher"
        },
        "userAvatar": {
          "type": "string",
          "description": "Avatar URL of the watcher"
        },
        "episodeNumber": {
          "type": "number",
          "description": "The episode number watched"
        },
        "watchedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user watched"
        }
      },
      "required": ["movieId", "userName", "watchedAt"]
    },
    "User": {
      "title": "User",
      "description": "User account and anime subscription permission record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID"
        },
        "name": {
          "type": "string",
          "description": "Full name or nickname"
        },
        "email": {
          "type": "string",
          "description": "Email address"
        },
        "phone": {
          "type": "string",
          "description": "Phone number"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user", "vip"],
          "description": "System role"
        },
        "status": {
          "type": "string",
          "enum": ["active", "blocked"],
          "description": "Account status"
        },
        "packageType": {
          "type": "string",
          "enum": ["full_vip", "anime", "movie", "free"],
          "description": "Content package subscription"
        },
        "packageExpiry": {
          "type": "string",
          "description": "Package expiration date string"
        },
        "walletBalance": {
          "type": "number",
          "description": "Wallet points or MNT balance"
        },
        "registeredAt": {
          "type": "string",
          "description": "Registration date and time string"
        },
        "registeredTimestamp": {
          "type": "number",
          "description": "Epoch timestamp of user registration"
        },
        "lastLogin": {
          "type": "string",
          "description": "Last login date and time"
        }
      },
      "required": ["id", "name", "phone"]
    },
    "RechargeRequest": {
      "title": "RechargeRequest",
      "description": "Payment and recharge requests submitted by users for anime package access",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Request ID"
        },
        "userId": {
          "type": "string",
          "description": "User ID"
        },
        "userName": {
          "type": "string",
          "description": "User name"
        },
        "userPhone": {
          "type": "string",
          "description": "User phone number"
        },
        "amount": {
          "type": "number",
          "description": "Paid amount"
        },
        "planId": {
          "type": "string",
          "description": "Plan key (15d, 1m, 2m, etc.)"
        },
        "durationDays": {
          "type": "number",
          "description": "Duration in days"
        },
        "packageType": {
          "type": "string",
          "description": "Package type granted (anime)"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Approval status"
        },
        "createdAt": {
          "type": "string",
          "description": "Submission time"
        }
      },
      "required": ["userId", "userPhone", "amount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts and subscription permissions"
    },
    "/recharge_requests/{reqId}": {
      "schema": "RechargeRequest",
      "description": "Recharge requests submitted by users for anime subscription approval"
    },
    "/scores/{scoreId}": {
      "schema": "Score",
      "description": "Leaderboard game scores"
    },
    "/movies/{movieId}": {
      "schema": "Movie",
      "description": "Anime and movies collection. Only master admin can create, update, or upload video entries."
    },
    "/episodes/{epId}": {
      "schema": "Episode",
      "description": "Video episodes collection. Only master admin can create, update, or upload video episodes."
    },
    "/anime_views/{viewId}": {
      "schema": "AnimeView",
      "description": "Anime viewing records and watcher user list"
    }
  }
}
