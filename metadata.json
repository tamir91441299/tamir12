{
  "name": "FlickNime - Анимэ Платформ",
  "description": "Монгол хадмал болон дуу оруулгатай шилдэг анимэ, цувралуудыг өндөр чанартайгаар үзэх FlickNime онлайн платформ.",
  "requestFramePermissions": [],
  "majorCapabilities": ["MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API"]
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Neon Anime</title>
  <style>
    :root {
      --bg: #0a0d18;
      --bg-2: #121827;
      --panel: rgba(18, 24, 39, 0.8);
      --primary: #ff3cac;
      --secondary: #784fff;
      --accent: #00d4ff;
      --text: #ecf4ff;
      --muted: #9aa8c2;
      --gold: #ffd166;
      --shadow: rgba(0, 0, 0, 0.45);
    }

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(255, 60, 172, 0.25), transparent 30%),
        radial-gradient(circle at top right, rgba(0, 212, 255, 0.2), transparent 25%),
        linear-gradient(135deg, var(--bg), var(--bg-2));
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        linear-gradient(rgba(255,255,255,0.02), rgba(255,255,255,0.02)),
        repeating-linear-gradient(
          to bottom,
          transparent 0px,
          transparent 2px,
          rgba(255,255,255,0.01) 3px
        );
      pointer-events: none;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .container {
      width: min(1200px, 90%);
      margin: 0 auto;
    }

    header {
      position: sticky;
      top: 0;
      background: rgba(10, 13, 24, 0.6);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      z-index: 50;
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 0;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .logo-mark {
      width: 36px;
      height: 36px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      display: grid;
      place-items: center;
      box-shadow: 0 0 25px rgba(255, 60, 172, 0.6);
      font-size: 18px;
    }

    .nav-menu {
      display: flex;
      gap: 28px;
      align-items: center;
      color: var(--muted);
      font-size: 0.96rem;
    }

    .nav-menu a:hover {
      color: var(--text);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .btn {
      padding: 12px 22px;
      border: none;
      border-radius: 999px;
      font-weight: 700;
      cursor: pointer;
      transition: 0.25s ease;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      box-shadow: 0 10px 25px rgba(120, 79, 255, 0.45);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 30px rgba(120, 79, 255, 0.6);
    }

    .btn-ghost {
      background: rgba(255,255,255,0.04);
      color: var(--text);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .hero {
      padding: 80px 0 60px;
      position: relative;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 40px;
    }

    .eyebrow {
      display: inline-block;
      background: rgba(255, 255, 255, 0.06);
      color: var(--accent);
      border: 1px solid rgba(0, 212, 255, 0.3);
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 0.78rem;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.8rem, 5vw, 5rem);
      line-height: 0.98;
      margin: 0 0 20px;
      letter-spacing: -2px;
    }

    .highlight {
      background: linear-gradient(135deg, var(--primary), var(--accent));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero p {
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.8;
      max-width: 600px;
      margin-bottom: 28px;
    }

    .hero-actions {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 26px;
    }

    .stats {
      display: flex;
      gap: 30px;
      flex-wrap: wrap;
      margin-top: 20px;
    }

    .stat {
      min-width: 110px;
    }

    .stat strong {
      display: block;
      font-size: 1.7rem;
      margin-bottom: 4px;
    }

    .stat span {
      color: var(--muted);
      font-size: 0.86rem;
    }

    .anime-card-wrap {
      display: flex;
      justify-content: center;
      position: relative;
      min-height: 560px;
    }

    .anime-card {
      width: min(420px, 92%);
      min-height: 560px;
      border-radius: 30px;
      background:
        linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02)),
        url('https://images.unsplash.com/photo-1531259683007-016a7b4446ad?auto=format&fit=crop&w=900&q=80') center/cover no-repeat;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.14);
    }

    .anime-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(8,10,18,0.1), rgba(8,10,18,0.82));
    }

    .card-content {
      position: absolute;
      inset: 0;
      padding: 26px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      z-index: 1;
    }

    .badge {
      display: inline-flex;
      align-self: flex-start;
      background: rgba(255, 209, 102, 0.15);
      color: var(--gold);
      border: 1px solid rgba(255, 209, 102, 0.35);
      border-radius: 999px;
      padding: 7px 12px;
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 1px;
      margin-bottom: 16px;
    }

    .anime-title {
      font-size: clamp(2rem, 3vw, 3rem);
      margin: 0 0 8px;
      line-height: 1.1;
    }

    .meta {
      display: flex;
      align-items: center;
      gap: 14px;
      color: rgba(255,255,255,0.82);
      font-size: 0.9rem;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    .meta .dot {
      width: 7px;
      height: 7px;
      background: var(--primary);
      border-radius: 50%;
      box-shadow: 0 0 12px rgba(255, 60, 172, 0.7);
    }

    .mini-info {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .mini-box {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.08);
      color: var(--text);
      padding: 10px 14px;
      border-radius: 14px;
      font-size: 0.8rem;
    }

    .section {
      padding: 24px 0 80px;
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 22px;
    }

    .section-head h2 {
      font-size: clamp(1.8rem, 2.5vw, 2.7rem);
      margin: 0;
    }

    .view-all {
      color: var(--accent);
      font-weight: 700;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .anime-item {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 24px;
      overflow: hidden;
      transition: transform 0.25s ease, border-color 0.25s ease;
      box-shadow: var(--shadow);
    }

    .anime-item:hover {
      transform: translateY(-8px);
      border-color: rgba(0, 212, 255, 0.4);
    }

    .poster {
      height: 320px;
      background-size: cover;
      background-position: center;
      position: relative;
    }

    .poster::after {
      content: "▶";
      position: absolute;
      right: 20px;
      bottom: 18px;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: rgba(10,13,24,0.7);
      border: 1px solid rgba(255,255,255,0.14);
      display: grid;
      place-items: center;
      font-size: 1.2rem;
      color: white;
      backdrop-filter: blur(8px);
    }

    .item-body {
      padding: 18px 18px 20px;
    }

    .item-body h3 {
      margin: 0 0 8px;
      font-size: 1.2rem;
    }

    .item-meta {
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: 0.9rem;
      margin-bottom: 14px;
    }

    .tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .tag {
      font-size: 0.76rem;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      color: var(--muted);
      padding: 6px 10px;
      border-radius: 999px;
    }

    .cta {
      margin-top: 36px;
      background: linear-gradient(135deg, rgba(255,60,172,0.14), rgba(0,212,255,0.12));
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 28px;
      padding: 30px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .cta h3 {
      margin: 0 0 8px;
      font-size: clamp(1.6rem, 2vw, 2.2rem);
    }

    .cta p {
      margin: 0;
      color: var(--muted);
    }

    .footer {
      padding: 20px 0 50px;
      text-align: center;
      color: var(--muted);
      font-size: 0.9rem;
    }

    @media (max-width: 900px) {
      .hero-grid,
      .grid {
        grid-template-columns: 1fr;
      }

      .nav-menu {
        display: none;
      }

      .anime-card-wrap {
        min-height: 480px;
      }

      .anime-card {
        min-height: 480px;
      }
    }

    @media (max-width: 560px) {
      .nav {
        gap: 12px;
      }

      .nav-actions {
        gap: 8px;
      }

      .btn {
        padding: 10px 16px;
        font-size: 0.82rem;
      }

      .stats {
        gap: 12px;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="container nav">
      <div class="logo">
        <div class="logo-mark">N</div>
        <span>NEON ANIME</span>
      </div>

      <nav class="nav-menu">
        <a href="#">Home</a>
        <a href="#">Genres</a>
        <a href="#">Trending</a>
        <a href="#">New Episodes</a>
        <a href="#">Community</a>
      </nav>

      <div class="nav-actions">
        <button class="btn btn-ghost">Sign In</button>
        <button class="btn btn-primary">Watch Now</button>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <div class="eyebrow">NEW SEASON</div>
          <h1>
            Feel the <span class="highlight">power</span><br />
            of every story
          </h1>
          <p>
            Watch epic anime adventures, emotional stories, and action-packed
            series in a cinematic space designed for true fans.
          </p>

          <div class="hero-actions">
            <button class="btn btn-primary">Start Watching</button>
            <button class="btn btn-ghost">Browse Library</button>
          </div>

          <div class="stats">
            <div class="stat">
              <strong>120K</strong>
              <span>members</span>
            </div>
            <div class="stat">
              <strong>4.9/5</strong>
              <span>rating</span>
            </div>
            <div class="stat">
              <strong>250+</strong>
              <span>titles</span>
            </div>
          </div>
        </div>

        <div class="anime-card-wrap">
          <div class="anime-card">
            <div class="card-content">
              <span class="badge">TOP PICK</span>
              <h2 class="anime-title">Shadow Blade</h2>
              <div class="meta">
                <span>2026</span>
                <span class="dot"></span>
                <span>Action / Fantasy</span>
                <span class="dot"></span>
                <span>12 EP</span>
              </div>

              <div class="mini-info">
                <div class="mini-box">8.9 IMDb</div>
                <div class="mini-box">Sub + Dub</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>Trending now</h2>
          <a href="#" class="view-all">View all</a>
        </div>

        <div class="grid">
          <article class="anime-item">
            <div class="poster" style="background-image:url('https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=800&q=80');"></div>
            <div class="item-body">
              <h3>Moonlight Strike</h3>
              <div class="item-meta">
                <span>Action</span>
                <span>24 min</span>
              </div>
              <div class="tags">
                <span class="tag">Epic</span>
                <span class="tag">Adventure</span>
              </div>
            </div>
          </article>

          <article class="anime-item">
            <div class="poster" style="background-image:url('https://images.unsplash.com/photo-1526379095098-d400fd0bf935?auto=format&fit=crop&w=800&q=80');"></div>
            <div class="item-body">
              <h3>Crimson Echo</h3>
              <div class="item-meta">
                <span>Drama</span>
                <span>22 min</span>
              </div>
              <div class="tags">
                <span class="tag">Emotional</span>
                <span class="tag">Mystery</span>
              </div>
            </div>
          </article>

          <article class="anime-item">
            <div class="poster" style="background-image:url('https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&w=800&q=80');"></div>
            <div class="item-body">
              <h3>Zenith Reborn</h3>
              <div class="item-meta">
                <span>Fantasy</span>
                <span>25 min</span>
              </div>
              <div class="tags">
                <span class="tag">Magic</span>
                <span class="tag">Sci-fi</span>
              </div>
            </div>
          </article>
        </div>

        <div class="cta">
          <div>
            <h3>Ready for your next obsession?</h3>
            <p>New episodes every week. Discover your next favorite anime today.</p>
          </div>
          <button class="btn btn-primary">Explore Now</button>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    © 2026 Neon Anime — Watch Anywhere
  </footer>
</body>
</html>













<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Anime Admin Panel</title>
  <style>
    :root{
      --bg:#0a0e18;
      --bg2:#121a2d;
      --panel:rgba(19,27,42,0.8);
      --primary:#ff4d9d;
      --secondary:#7c5cff;
      --accent:#00d7ff;
      --text:#edf6ff;
      --muted:#a7b4ca;
      --line:rgba(255,255,255,0.08);
      --danger:#ff6b6b;
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Segoe UI, Tahoma, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(255,77,157,0.22), transparent 28%),
        radial-gradient(circle at top right, rgba(0,215,255,0.2), transparent 24%),
        linear-gradient(130deg, var(--bg), var(--bg2));
      color:var(--text);
      min-height:100vh;
    }

    button,input,select{
      font:inherit;
    }

    .container{
      width:min(1200px, 92%);
      margin:0 auto;
    }

    header{
      background:rgba(10,14,24,0.65);
      border-bottom:1px solid var(--line);
      backdrop-filter:blur(12px);
      position:sticky;
      top:0;
      z-index:50;
    }

    .nav{
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:18px 0;
    }

    .logo{
      display:flex; align-items:center; gap:12px;
      font-weight:800; letter-spacing:1px;
    }

    .logo-mark{
      width:38px;height:38px;border-radius:12px;
      display:grid;place-items:center;
      background:linear-gradient(135deg, var(--primary), var(--secondary));
      box-shadow:0 0 25px rgba(255,77,157,0.7);
    }

    .role-switch{
      display:flex; gap:10px; flex-wrap:wrap;
    }

    .role-btn{
      background:rgba(255,255,255,0.04);
      border:1px solid var(--line);
      color:var(--text);
      border-radius:999px;
      padding:10px 16px;
      cursor:pointer;
      font-weight:700;
    }

    .role-btn.active{
      background:linear-gradient(135deg, var(--primary), var(--secondary));
      border:none;
      box-shadow:0 10px 25px rgba(124,92,255,0.4);
    }

    .layout{
      display:grid;
      grid-template-columns:360px 1fr;
      gap:24px;
      padding:30px 0 60px;
    }

    .panel{
      background:rgba(255,255,255,0.03);
      border:1px solid var(--line);
      border-radius:24px;
      box-shadow:0 18px 34px rgba(0,0,0,0.18);
    }

    .admin-box{
      padding:22px;
      position:sticky;
      top:92px;
    }

    .admin-title{
      margin:0 0 18px;
      font-size:1.5rem;
    }

    .permission-note{
      display:none;
      padding:12px 14px;
      border-radius:12px;
      margin-bottom:18px;
      font-size:0.92rem;
      background:rgba(255,107,107,0.08);
      border:1px solid rgba(255,107,107,0.3);
      color:#ffc2c2;
    }

    .permission-note.show{
      display:block;
    }

    .form-group{
      margin-bottom:16px;
    }

    label{
      display:block;
      margin-bottom:8px;
      color:var(--muted);
      font-size:0.9rem;
    }

    input, select{
      width:100%;
      padding:12px 14px;
      border-radius:12px;
      border:1px solid var(--line);
      background:rgba(255,255,255,0.03);
      color:var(--text);
      outline:none;
    }

    input:focus, select:focus{
      border-color:rgba(0,215,255,0.5);
      box-shadow:0 0 0 3px rgba(0,215,255,0.12);
    }

    .hidden{
      display:none !important;
    }

    .btn-submit{
      width:100%;
      margin-top:8px;
      padding:14px 18px;
      border:none;
      border-radius:12px;
      font-weight:700;
      cursor:pointer;
      color:white;
      background:linear-gradient(135deg, var(--primary), var(--secondary));
      box-shadow:0 12px 30px rgba(124,92,255,0.4);
    }

    .content{
      display:flex;
      flex-direction:column;
      gap:20px;
    }

    .topbar{
      padding:22px 24px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
      gap:16px;
    }

    .topbar h2{
      margin:0;
      font-size:clamp(1.7rem, 2vw, 2.5rem);
    }

    .count{
      color:var(--muted);
      font-size:0.92rem;
      background:rgba(255,255,255,0.04);
      border:1px solid var(--line);
      border-radius:999px;
      padding:8px 12px;
    }

    .video-grid{
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:22px;
      padding:0 0 10px;
    }

    .video-card{
      background:rgba(255,255,255,0.03);
      border:1px solid var(--line);
      border-radius:22px;
      overflow:hidden;
    }

    .thumb{
      position:relative;
      height:220px;
      background-size:cover;
      background-position:center;
    }

    .thumb::after{
      content:"▶";
      position:absolute;
      right:18px; bottom:16px;
      width:52px;height:52px;
      display:grid;place-items:center;
      border-radius:50%;
      background:rgba(10,14,24,0.7);
      border:1px solid rgba(255,255,255,0.12);
      color:white;
      font-size:1.1rem;
    }

    .video-body{
      padding:18px 18px 20px;
    }

    .video-top{
      display:flex; justify-content:space-between; gap:12px; align-items:center;
      margin-bottom:10px;
    }

    .tag{
      padding:6px 10px; border-radius:999px;
      font-size:0.76rem;
      background:rgba(255,255,255,0.04);
      border:1px solid var(--line);
      color:var(--muted);
    }

    .video-body h3{
      margin:0 0 8px;
      font-size:1.25rem;
    }

    .meta{
      display:flex; justify-content:space-between;
      color:var(--muted); font-size:0.88rem;
      margin-bottom:12px;
    }

    .video-body p{
      color:var(--muted);
      line-height:1.7;
      font-size:0.96rem;
      margin:0 0 16px;
    }

    .video-actions{
      display:flex; justify-content:space-between; gap:10px;
    }

    .watch-btn, .delete-btn{
      border:none; border-radius:12px;
      cursor:pointer; padding:10px 12px; font-weight:700;
    }

    .watch-btn{
      background:linear-gradient(135deg, var(--primary), var(--secondary));
      color:white;
      flex:1;
    }

    .delete-btn{
      background:rgba(255,255,255,0.04);
      border:1px solid var(--line);
      color:var(--text);
    }

    .empty{
      padding:26px;
      border:1px dashed var(--line);
      border-radius:20px;
      text-align:center;
      color:var(--muted);
      background:rgba(255,255,255,0.02);
    }

    @media (max-width:980px){
      .layout{grid-template-columns:1fr}
      .admin-box{position:static}
      .video-grid{grid-template-columns:1fr}
    }

    @media (max-width:560px){
      .video-actions{flex-direction:column}
    }
  </style>
</head>
<body>
  <header>
    <div class="container nav">
      <div class="logo">
        <div class="logo-mark">N</div>
        <span>ANIMENEXA</span>
      </div>

      <div class="role-switch">
        <button class="role-btn active" data-role="admin">Admin</button>
        <button class="role-btn" data-role="user">User</button>
      </div>
    </div>
  </header>

  <div class="container layout">
    <aside class="panel admin-box">
      <h1 class="admin-title">Video manager</h1>

      <div id="permissionNote" class="permission-note">
        You are a regular user. You cannot add videos.
      </div>

      <form id="videoForm">
        <div class="form-group">
          <label for="title">Video title</label>
          <input id="title" type="text" placeholder="Shadow Blade" required />
        </div>

        <div class="form-group">
          <label for="category">Category</label>
          <select id="category">
            <option value="Action">Action</option>
            <option value="Fantasy">Fantasy</option>
            <option value="Drama">Drama</option>
            <option value="Adventure">Adventure</option>
          </select>
        </div>

        <div class="form-group">
          <label for="image">Image URL</label>
          <input id="image" type="url" placeholder="https://..." required />
        </div>

        <div class="form-group">
          <label for="videoUrl">Video URL</label>
          <input id="videoUrl" type="url" placeholder="https://..." required />
        </div>

        <div class="form-group">
          <label for="duration">Duration</label>
          <input id="duration" type="text" placeholder="24 min" required />
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <input id="description" type="text" placeholder="Short info..." required />
        </div>

        <button class="btn-submit" type="submit">Add video</button>
      </form>
    </aside>

    <main class="content">
      <div class="panel topbar">
        <h2>Uploaded videos</h2>
        <div id="videoCount" class="count">0 items</div>
      </div>

      <div id="videoList" class="video-grid"></div>
    </main>
  </div>

  <script>
    const STORAGE_KEY = "animeProtectedVideos";

    const defaultVideos = [
      {
        id: 1,
        title: "Moonlight Strike",
        category: "Action",
        image: "https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=900&q=80",
        videoUrl: "https://www.youtube.com/watch?v=ysz5S6PUM-U",
        duration: "24 min",
        description: "A mysterious swordsman begins a dangerous battle to protect his city."
      },
      {
        id: 2,
        title: "Crimson Echo",
        category: "Drama",
        image: "https://images.unsplash.com/photo-1526379095098-d400fd0bf935?auto=format&fit=crop&w=900&q=80",
        videoUrl: "https://www.youtube.com/watch?v=ScMzIvxBSi4",
        duration: "22 min",
        description: "A forgotten past returns when the sky turns crimson every night."
      }
    ];

    let currentRole = "admin";

    const videoForm = document.getElementById("videoForm");
    const permissionNote = document.getElementById("permissionNote");
    const videoList = document.getElementById("videoList");
    const videoCount = document.getElementById("videoCount");

    function loadVideos() {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (!saved) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(defaultVideos));
        return [...defaultVideos];
      }
      try {
        const parsed = JSON.parse(saved);
        return Array.isArray(parsed) && parsed.length ? parsed : [...defaultVideos];
      } catch {
        return [...defaultVideos];
      }
    }

    let videos = loadVideos();

    function saveVideos() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(videos));
    }

    function updateRoleUI() {
      const roleButtons = document.querySelectorAll(".role-btn");
      roleButtons.forEach(btn => {
        btn.classList.toggle("active", btn.dataset.role === currentRole);
      });

      const isAdmin = currentRole === "admin";
      videoForm.classList.toggle("hidden", !isAdmin);
      permissionNote.classList.toggle("show", !isAdmin);

      if (!isAdmin) {
        permissionNote.textContent = "You are a regular user. You cannot add videos.";
      }
    }

    function renderVideos() {
      if (!videos.length) {
        videoList.innerHTML = `
          <div class="empty">
            No videos added yet.
          </div>
        `;
        videoCount.textContent = "0 items";
        return;
      }

      videoList.innerHTML = videos.map(video => `
        <article class="video-card">
          <div class="thumb" style="background-image:url('${video.image}')"></div>
          <div class="video-body">
            <div class="video-top">
              <span class="tag">${video.category}</span>
              <span class="tag">${video.duration}</span>
            </div>

            <h3>${video.title}</h3>

            <div class="meta">
              <span>Anime</span>
              <span>HD</span>
            </div>

            <p>${video.description}</p>

            <div class="video-actions">
              <button class="watch-btn" onclick="window.open('${video.videoUrl}', '_blank')">Watch</button>
              <button class="delete-btn" data-id="${video.id}">Delete</button>
            </div>
          </div>
        </article>
      `).join("");

      videoCount.textContent = `${videos.length} item${videos.length === 1 ? "" : "s"}`;

      document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const id = Number(btn.dataset.id);
          if (currentRole !== "admin") {
            permissionNote.textContent = "Only admin can delete videos.";
            permissionNote.classList.add("show");
            return;
          }

          videos = videos.filter(v => v.id !== id);
          saveVideos();
          renderVideos();
        });
      });
    }

    document.querySelectorAll(".role-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        currentRole = btn.dataset.role;
        updateRoleUI();
      });
    });

    videoForm.addEventListener("submit", function(e){
      e.preventDefault();

      if (currentRole !== "admin") {
        permissionNote.textContent = "Only admin can add videos.";
        permissionNote.classList.add("show");
        return;
      }

      const title = document.getElementById("title").value.trim();
      const category = document.getElementById("category").value;
      const image = document.getElementById("image").value.trim();
      const videoUrl = document.getElementById("videoUrl").value.trim();
      const duration = document.getElementById("duration").value.trim();
      const description = document.getElementById("description").value.trim();

      if (!title || !image || !videoUrl || !duration || !description) return;

      videos.unshift({
        id: Date.now(),
        title,
        category,
        image,
        videoUrl,
        duration,
        description
      });

      saveVideos();
      renderVideos();
      videoForm.reset();
    });

    updateRoleUI();
    renderVideos();
  </script>
</body>
</html>
 


 <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Anime Admin Panel</title>
  <style>
    :root{
      --bg:#0a0e18;
      --bg2:#121a2d;
      --panel:rgba(19,27,42,0.8);
      --primary:#ff4d9d;
      --secondary:#7c5cff;
      --accent:#00d7ff;
      --text:#edf6ff;
      --muted:#a7b4ca;
      --line:rgba(255,255,255,0.08);
      --danger:#ff6b6b;
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Segoe UI, Tahoma, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(255,77,157,0.22), transparent 28%),
        radial-gradient(circle at top right, rgba(0,215,255,0.2), transparent 24%),
        linear-gradient(130deg, var(--bg), var(--bg2));
      color:var(--text);
      min-height:100vh;
    }

    button,input,select{
      font:inherit;
    }

    .container{
      width:min(1200px, 92%);
      margin:0 auto;
    }

    header{
      background:rgba(10,14,24,0.65);
      border-bottom:1px solid var(--line);
      backdrop-filter:blur(12px);
      position:sticky;
      top:0;
      z-index:50;
    }

    .nav{
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:18px 0;
    }

    .logo{
      display:flex; align-items:center; gap:12px;
      font-weight:800; letter-spacing:1px;
    }

    .logo-mark{
      width:38px;height:38px;border-radius:12px;
      display:grid;place-items:center;
      background:linear-gradient(135deg, var(--primary), var(--secondary));
      box-shadow:0 0 25px rgba(255,77,157,0.7);
    }

    .role-switch{
      display:flex; gap:10px; flex-wrap:wrap;
    }

    .role-btn{
      background:rgba(255,255,255,0.04);
      border:1px solid var(--line);
      color:var(--text);
      border-radius:999px;
      padding:10px 16px;
      cursor:pointer;
      font-weight:700;
    }

    .role-btn.active{
      background:linear-gradient(135deg, var(--primary), var(--secondary));
      border:none;
      box-shadow:0 10px 25px rgba(124,92,255,0.4);
    }

    .layout{
      display:grid;
      grid-template-columns:360px 1fr;
      gap:24px;
      padding:30px 0 60px;
    }

    .panel{
      background:rgba(255,255,255,0.03);
      border:1px solid var(--line);
      border-radius:24px;
      box-shadow:0 18px 34px rgba(0,0,0,0.18);
    }

    .admin-box{
      padding:22px;
      position:sticky;
      top:92px;
    }

    .admin-title{
      margin:0 0 18px;
      font-size:1.5rem;
    }

    .permission-note{
      display:none;
      padding:12px 14px;
      border-radius:12px;
      margin-bottom:18px;
      font-size:0.92rem;
      background:rgba(255,107,107,0.08);
      border:1px solid rgba(255,107,107,0.3);
      color:#ffc2c2;
    }

    .permission-note.show{
      display:block;
    }

    .form-group{
      margin-bottom:16px;
    }

    label{
      display:block;
      margin-bottom:8px;
      color:var(--muted);
      font-size:0.9rem;
    }

    input, select{
      width:100%;
      padding:12px 14px;
      border-radius:12px;
      border:1px solid var(--line);
      background:rgba(255,255,255,0.03);
      color:var(--text);
      outline:none;
    }

    input:focus, select:focus{
      border-color:rgba(0,215,255,0.5);
      box-shadow:0 0 0 3px rgba(0,215,255,0.12);
    }

    .hidden{
      display:none !important;
    }

    .btn-submit{
      width:100%;
      margin-top:8px;
      padding:14px 18px;
      border:none;
      border-radius:12px;
      font-weight:700;
      cursor:pointer;
      color:white;
      background:linear-gradient(135deg, var(--primary), var(--secondary));
      box-shadow:0 12px 30px rgba(124,92,255,0.4);
    }

    .content{
      display:flex;
      flex-direction:column;
      gap:20px;
    }

    .topbar{
      padding:22px 24px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
      gap:16px;
    }

    .topbar h2{
      margin:0;
      font-size:clamp(1.7rem, 2vw, 2.5rem);
    }

    .count{
      color:var(--muted);
      font-size:0.92rem;
      background:rgba(255,255,255,0.04);
      border:1px solid var(--line);
      border-radius:999px;
      padding:8px 12px;
    }

    .video-grid{
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:22px;
      padding:0 0 10px;
    }

    .video-card{
      background:rgba(255,255,255,0.03);
      border:1px solid var(--line);
      border-radius:22px;
      overflow:hidden;
    }

    .thumb{
      position:relative;
      height:220px;
      background-size:cover;
      background-position:center;
    }

    .thumb::after{
      content:"▶";
      position:absolute;
      right:18px; bottom:16px;
      width:52px;height:52px;
      display:grid;place-items:center;
      border-radius:50%;
      background:rgba(10,14,24,0.7);
      border:1px solid rgba(255,255,255,0.12);
      color:white;
      font-size:1.1rem;
    }

    .video-body{
      padding:18px 18px 20px;
    }

    .video-top{
      display:flex; justify-content:space-between; gap:12px; align-items:center;
      margin-bottom:10px;
    }

    .tag{
      padding:6px 10px; border-radius:999px;
      font-size:0.76rem;
      background:rgba(255,255,255,0.04);
      border:1px solid var(--line);
      color:var(--muted);
    }

    .video-body h3{
      margin:0 0 8px;
      font-size:1.25rem;
    }

    .meta{
      display:flex; justify-content:space-between;
      color:var(--muted); font-size:0.88rem;
      margin-bottom:12px;
    }

    .video-body p{
      color:var(--muted);
      line-height:1.7;
      font-size:0.96rem;
      margin:0 0 16px;
    }

    .video-actions{
      display:flex; justify-content:space-between; gap:10px;
    }

    .watch-btn, .delete-btn{
      border:none; border-radius:12px;
      cursor:pointer; padding:10px 12px; font-weight:700;
    }

    .watch-btn{
      background:linear-gradient(135deg, var(--primary), var(--secondary));
      color:white;
      flex:1;
    }

    .delete-btn{
      background:rgba(255,255,255,0.04);
      border:1px solid var(--line);
      color:var(--text);
    }

    .empty{
      padding:26px;
      border:1px dashed var(--line);
      border-radius:20px;
      text-align:center;
      color:var(--muted);
      background:rgba(255,255,255,0.02);
    }

    @media (max-width:980px){
      .layout{grid-template-columns:1fr}
      .admin-box{position:static}
      .video-grid{grid-template-columns:1fr}
    }

    @media (max-width:560px){
      .video-actions{flex-direction:column}
    }
  </style>
</head>
<body>
  <header>
    <div class="container nav">
      <div class="logo">
        <div class="logo-mark">N</div>
        <span>ANIMENEXA</span>
      </div>

