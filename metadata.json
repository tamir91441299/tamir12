          videos = videos.filter(v => v.id !== id);
          saveVideos();
          renderVideos();
        });
      });
    }

    document.querySelectorAll(".role-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        currentRole = btn.dataset.role;
        updateRoleUI();
      });
    });

    videoForm.addEventListener("submit", function(e){
      e.preventDefault();

      if (currentRole !== "admin") {
        permissionNote.textContent = "Only admin can add videos.";
        permissionNote.classList.add("show");
        return;
      }

      const title = document.getElementById("title").value.trim();
      const category = document.getElementById("category").value;
      const image = document.getElementById("image").value.trim();
      const videoUrl = document.getElementById("videoUrl").value.trim();
      const duration = document.getElementById("duration").value.trim();
      const description = document.getElementById("description").value.trim();

      if (!title || !image || !videoUrl || !duration || !description) return;

      videos.unshift({
        id: Date.now(),
        title,
        category,
        image,
        videoUrl,
        duration,
        description
      });

      saveVideos();
      renderVideos();
      videoForm.reset();
    });

    updateRoleUI();
    renderVideos();
  </script>
</body>
</html>

*{ box-sizing:border-box; }
html, body{
  margin:0;
  height:100%;
  background:var(--bg);
  color:var(--white);
  font-family: Arial, Helvetica, sans-serif;
}

body{
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

.screen{
  width:100vw;
  height:100vh;
  position:relative;
  background:
    linear-gradient(rgba(0,0,0,0.18), rgba(0,0,0,0.18)),
    url("https://images.unsplash.com/photo-1521119989659-a83eee488004?auto=format&fit=crop&w=1400&q=80") center center / cover no-repeat;
  filter:saturate(0.7) contrast(1.05);
}

.screen::before{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(180deg, rgba(0,0,0,0.16), rgba(0,0,0,0.46));
}

.top-bar{
  position:absolute;
  top:22px;
  left:0;
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 28px 0 24px;
  z-index:3;
}

.progress-line{
  flex:1;
  height:3px;
  border-radius:999px;
  position:relative;
  background:rgba(255,255,255,0.75);
  margin-right:18px;
  overflow:hidden;
  box-shadow:0 0 12px rgba(255,255,255,0.25);
}

.progress-line::before{
  content:"";
  position:absolute;
  left:0;
  top:0;
  width:54%;
  height:100%;
  background:rgba(255,255,255,0.9);
}

.progress-line::after{
  content:"";
  position:absolute;
  right:0;
  top:50%;
  transform:translateY(-50%);
  width:14px;
  height:14px;
  border-radius:50%;
  background:rgba(255,255,255,0.9);
  box-shadow:0 0 10px rgba(255,255,255,0.9);
}

.mini-scroller{
  position:absolute;
  left:0;
  top:50%;
  transform:translateY(-50%);
  width:12px;
  height:50px;
  background:rgba(255,255,255,0.8);
  border-radius:0 10px 10px 0;
  box-shadow:0 0 10px rgba(255,255,255,0.35);
}

.exit-btn{
  min-width:180px;
  height:52px;
  border:none;
  border-radius:16px;
  background:linear-gradient(180deg, #f14f67, #e93d5d);
  color:var(--white);
  font-size:26px;
  font-weight:700;
  letter-spacing:0.5px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:12px;
  box-shadow:0 8px 25px rgba(242,61,91,0.35);
  cursor:pointer;
  padding:0 18px;
}

.exit-btn .x{
  font-size:28px;
  line-height:1;
  margin-top:-2px;
}

.exit-btn .label{
  font-size:22px;
  font-weight:700;
  letter-spacing:0.5px;
}

.controls-upper{
  position:absolute;
  right:60px;
  bottom:122px;
  display:flex;
  align-items:center;
  gap:18px;
  padding:16px 20px;
  border-radius:18px;
  background:rgba(40, 43, 50, 0.6);
  border:1px solid rgba(255,255,255,0.08);
  box-shadow:0 10px 24px rgba(0,0,0,0.35);
  z-index:3;
  backdrop-filter: blur(8px);
}

.icon-btn{
  width:56px;
  height:56px;
  border-radius:14px;
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.08);
  display:grid;
  place-items:center;
  color:var(--white);
  cursor:pointer;
  transition:transform 0.15s ease;
}

.icon-btn:hover{
  transform:translateY(-1px);
}

.icon {
  width:28px;
  height:28px;
  display:block;
}

.icon svg{
  width:100%;
  height:100%;
  stroke:currentColor;
  fill:none;
  stroke-width:2.5;
  stroke-linecap:round;
  stroke-linejoin:round;
}

.speed-badge{
  min-width:62px;
  height:56px;
  border-radius:14px;
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.08);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:24px;
  font-weight:700;
  color:var(--white);
}

.bottom-bar{
  position:absolute;
  left:50%;
  bottom:30px;
  transform:translateX(-50%);
  display:flex;
  align-items:center;
  justify-content:center;
  gap:28px;
  z-index:3;
  width:min(92vw, 520px);
}

.bottom-pill{
  background:rgba(22,24,30,0.72);
  border:1px solid rgba(255,255,255,0.08);
  border-radius:18px;
  box-shadow:0 10px 24px rgba(0,0,0,0.35);
  backdrop-filter: blur(8px);
}

.pause-btn{
  width:120px;
  height:70px;
  display:grid;
  place-items:center;
  cursor:pointer;
}

.pause-btn .icon {
  width:34px;
  height:34px;
}

.mid-btn{
  width:120px;
  height:70px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:16px;
  padding:0 18px;
}

.mid-btn .small{
  width:40px;
  height:40px;
  border-radius:12px;
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.08);
  display:grid;
  place-items:center;
}

.time{
  font-size:18px;
  color:var(--muted);
  font-weight:600;
  letter-spacing:1px;
  white-space:nowrap;
}

.time .current{
  color:var(--white);
}

.play-toggle{
  width:120px;
  height:70px;
  display:grid;
  place-items:center;
  cursor:pointer;
}

.play-toggle .icon{
  width:28px;
  height:28px;
}

.sr-only{
  position:absolute;
  width:1px;
  height:1px;
  margin:-1px;
  padding:0;
  overflow:hidden;
  clip:rect(0,0,0,0);
  white-space:nowrap;
  border:0;
}






