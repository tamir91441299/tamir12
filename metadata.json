{
  "name": "FlickNime - Анимэ Платформ",
  "description": "Монгол хадмал болон дуу оруулгатай шилдэг анимэ, цувралуудыг өндөр чанартайгаар үзэх FlickNime онлайн платформ.",
  "requestFramePermissions": [],
  "majorCapabilities": ["MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API"]
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Neon Anime</title>
  <style>
    :root {
      --bg: #0a0d18;
      --bg-2: #121827;
      --panel: rgba(18, 24, 39, 0.8);
      --primary: #ff3cac;
      --secondary: #784fff;
      --accent: #00d4ff;
      --text: #ecf4ff;
      --muted: #9aa8c2;
      --gold: #ffd166;
      --shadow: rgba(0, 0, 0, 0.45);
    }

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(255, 60, 172, 0.25), transparent 30%),
        radial-gradient(circle at top right, rgba(0, 212, 255, 0.2), transparent 25%),
        linear-gradient(135deg, var(--bg), var(--bg-2));
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        linear-gradient(rgba(255,255,255,0.02), rgba(255,255,255,0.02)),
        repeating-linear-gradient(
          to bottom,
          transparent 0px,
          transparent 2px,
          rgba(255,255,255,0.01) 3px
        );
      pointer-events: none;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .container {
      width: min(1200px, 90%);
      margin: 0 auto;
    }

    header {
      position: sticky;
      top: 0;
      background: rgba(10, 13, 24, 0.6);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      z-index: 50;
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 0;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .logo-mark {
      width: 36px;
      height: 36px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      display: grid;
      place-items: center;
      box-shadow: 0 0 25px rgba(255, 60, 172, 0.6);
      font-size: 18px;
    }

    .nav-menu {
      display: flex;
      gap: 28px;
      align-items: center;
      color: var(--muted);
      font-size: 0.96rem;
    }

    .nav-menu a:hover {
      color: var(--text);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .btn {
      padding: 12px 22px;
      border: none;
      border-radius: 999px;
      font-weight: 700;
      cursor: pointer;
      transition: 0.25s ease;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      box-shadow: 0 10px 25px rgba(120, 79, 255, 0.45);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 30px rgba(120, 79, 255, 0.6);
    }

    .btn-ghost {
      background: rgba(255,255,255,0.04);
      color: var(--text);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .hero {
      padding: 80px 0 60px;
      position: relative;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 40px;
    }

    .eyebrow {
      display: inline-block;
      background: rgba(255, 255, 255, 0.06);
      color: var(--accent);
      border: 1px solid rgba(0, 212, 255, 0.3);
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 0.78rem;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.8rem, 5vw, 5rem);
      line-height: 0.98;
      margin: 0 0 20px;
      letter-spacing: -2px;
    }

    .highlight {
      background: linear-gradient(135deg, var(--primary), var(--accent));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero p {
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.8;
      max-width: 600px;
      margin-bottom: 28px;
    }

    .hero-actions {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 26px;
    }

    .stats {
      display: flex;
      gap: 30px;
      flex-wrap: wrap;
      margin-top: 20px;
    }

    .stat {
      min-width: 110px;
    }

    .stat strong {
      display: block;
      font-size: 1.7rem;
      margin-bottom: 4px;
    }

    .stat span {
      color: var(--muted);
      font-size: 0.86rem;
    }

    .anime-card-wrap {
      display: flex;
      justify-content: center;
      position: relative;
      min-height: 560px;
    }

    .anime-card {
      width: min(420px, 92%);
      min-height: 560px;
      border-radius: 30px;
      background:
        linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02)),
        url('https://images.unsplash.com/photo-1531259683007-016a7b4446ad?auto=format&fit=crop&w=900&q=80') center/cover no-repeat;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.14);
    }

    .anime-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(8,10,18,0.1), rgba(8,10,18,0.82));
    }

    .card-content {
      position: absolute;
      inset: 0;
      padding: 26px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      z-index: 1;
    }

    .badge {
      display: inline-flex;
      align-self: flex-start;
      background: rgba(255, 209, 102, 0.15);
      color: var(--gold);
      border: 1px solid rgba(255, 209, 102, 0.35);
      border-radius: 999px;
      padding: 7px 12px;
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 1px;
      margin-bottom: 16px;
    }

    .anime-title {
      font-size: clamp(2rem, 3vw, 3rem);
      margin: 0 0 8px;
      line-height: 1.1;
    }

    .meta {
      display: flex;
      align-items: center;
      gap: 14px;
      color: rgba(255,255,255,0.82);
      font-size: 0.9rem;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    .meta .dot {
      width: 7px;
      height: 7px;
      background: var(--primary);
      border-radius: 50%;
      box-shadow: 0 0 12px rgba(255, 60, 172, 0.7);
    }

    .mini-info {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .mini-box {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.08);
      color: var(--text);
      padding: 10px 14px;
      border-radius: 14px;
      font-size: 0.8rem;
    }

    .section {
      padding: 24px 0 80px;
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 22px;
    }

    .section-head h2 {
      font-size: clamp(1.8rem, 2.5vw, 2.7rem);
      margin: 0;
    }

    .view-all {
      color: var(--accent);
      font-weight: 700;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .anime-item {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 24px;
      overflow: hidden;
      transition: transform 0.25s ease, border-color 0.25s ease;
      box-shadow: var(--shadow);
    }

    .anime-item:hover {
      transform: translateY(-8px);
      border-color: rgba(0, 212, 255, 0.4);
    }

    .poster {
      height: 320px;
      background-size: cover;
      background-position: center;
      position: relative;
    }

    .poster::after {
      content: "▶";
      position: absolute;
      right: 20px;
      bottom: 18px;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: rgba(10,13,24,0.7);
      border: 1px solid rgba(255,255,255,0.14);
      display: grid;
      place-items: center;
      font-size: 1.2rem;
      color: white;
      backdrop-filter: blur(8px);
    }

    .item-body {
      padding: 18px 18px 20px;
    }

    .item-body h3 {
      margin: 0 0 8px;
      font-size: 1.2rem;
    }

    .item-meta {
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: 0.9rem;
      margin-bottom: 14px;
    }

    .tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .tag {
      font-size: 0.76rem;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      color: var(--muted);
      padding: 6px 10px;
      border-radius: 999px;
    }

    .cta {
      margin-top: 36px;
      background: linear-gradient(135deg, rgba(255,60,172,0.14), rgba(0,212,255,0.12));
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 28px;
      padding: 30px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .cta h3 {
      margin: 0 0 8px;
      font-size: clamp(1.6rem, 2vw, 2.2rem);
    }

    .cta p {
      margin: 0;
      color: var(--muted);
    }

    .footer {
      padding: 20px 0 50px;
      text-align: center;
      color: var(--muted);
      font-size: 0.9rem;
    }

    @media (max-width: 900px) {
      .hero-grid,
      .grid {
        grid-template-columns: 1fr;
      }

      .nav-menu {
        display: none;
      }

      .anime-card-wrap {
        min-height: 480px;
      }

      .anime-card {
        min-height: 480px;
      }
    }

    @media (max-width: 560px) {
      .nav {
        gap: 12px;
      }

      .nav-actions {
        gap: 8px;
      }

      .btn {
        padding: 10px 16px;
        font-size: 0.82rem;
      }

      .stats {
        gap: 12px;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="container nav">
      <div class="logo">
        <div class="logo-mark">N</div>
        <span>NEON ANIME</span>
      </div>

      <nav class="nav-menu">
        <a href="#">Home</a>
        <a href="#">Genres</a>
        <a href="#">Trending</a>
        <a href="#">New Episodes</a>
        <a href="#">Community</a>
      </nav>

      <div class="nav-actions">
        <button class="btn btn-ghost">Sign In</button>
        <button class="btn btn-primary">Watch Now</button>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <div class="eyebrow">NEW SEASON</div>
          <h1>
            Feel the <span class="highlight">power</span><br />
            of every story
          </h1>
          <p>
            Watch epic anime adventures, emotional stories, and action-packed
            series in a cinematic space designed for true fans.
          </p>

          <div class="hero-actions">
            <button class="btn btn-primary">Start Watching</button>
            <button class="btn btn-ghost">Browse Library</button>
          </div>

          <div class="stats">
            <div class="stat">
              <strong>120K</strong>
              <span>members</span>
            </div>
            <div class="stat">
              <strong>4.9/5</strong>
              <span>rating</span>
            </div>
            <div class="stat">
              <strong>250+</strong>
              <span>titles</span>
            </div>
          </div>
        </div>

        <div class="anime-card-wrap">
          <div class="anime-card">
            <div class="card-content">
              <span class="badge">TOP PICK</span>
              <h2 class="anime-title">Shadow Blade</h2>
              <div class="meta">
                <span>2026</span>
                <span class="dot"></span>
                <span>Action / Fantasy</span>
                <span class="dot"></span>
                <span>12 EP</span>
              </div>

              <div class="mini-info">
                <div class="mini-box">8.9 IMDb</div>
                <div class="mini-box">Sub + Dub</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>Trending now</h2>
          <a href="#" class="view-all">View all</a>
        </div>

        <div class="grid">
          <article class="anime-item">
            <div class="poster" style="background-image:url('https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=800&q=80');"></div>
            <div class="item-body">
              <h3>Moonlight Strike</h3>
              <div class="item-meta">
                <span>Action</span>
                <span>24 min</span>
              </div>
              <div class="tags">
                <span class="tag">Epic</span>
                <span class="tag">Adventure</span>
              </div>
            </div>
          </article>

          <article class="anime-item">
            <div class="poster" style="background-image:url('https://images.unsplash.com/photo-1526379095098-d400fd0bf935?auto=format&fit=crop&w=800&q=80');"></div>
            <div class="item-body">
              <h3>Crimson Echo</h3>
              <div class="item-meta">
                <span>Drama</span>
                <span>22 min</span>
              </div>
              <div class="tags">
                <span class="tag">Emotional</span>
                <span class="tag">Mystery</span>
              </div>
            </div>
          </article>

          <article class="anime-item">
            <div class="poster" style="background-image:url('https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&w=800&q=80');"></div>
            <div class="item-body">
              <h3>Zenith Reborn</h3>
              <div class="item-meta">
                <span>Fantasy</span>
                <span>25 min</span>
              </div>
              <div class="tags">
                <span class="tag">Magic</span>
                <span class="tag">Sci-fi</span>
              </div>
            </div>
          </article>
        </div>

        <div class="cta">
          <div>
            <h3>Ready for your next obsession?</h3>
            <p>New episodes every week. Discover your next favorite anime today.</p>
          </div>
          <button class="btn btn-primary">Explore Now</button>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    © 2026 Neon Anime — Watch Anywhere
  </footer>
</body>
</html>










